# Sandbox-only live integration tests. Never commit real values.
ASSINAFY_LIVE=0
ASSINAFY_LIVE_DESTRUCTIVE=0
# Extra opt-in for isolated workspace/logo/webhook create-update-delete checks.
ASSINAFY_LIVE_WORKSPACE_MUTATIONS=0
# Extra opt-in for assignment and notification checks that consume account credits.
ASSINAFY_LIVE_CREDIT_MUTATIONS=0
ASSINAFY_API_KEY=<sandbox-api-key>
ASSINAFY_ACCOUNT_ID=<sandbox-account-id>
ASSINAFY_BASE_URL=https://sandbox.assinafy.com.br/v1
# Required only when ASSINAFY_LIVE_CREDIT_MUTATIONS=1.
ASSINAFY_TEST_EMAIL_PRIMARY=<sandbox-test-email>
ASSINAFY_TEST_EMAIL_SECONDARY=<second-sandbox-test-email>
# Optional. Signer-side endpoints authenticate with a per-signer access code that
# no API endpoint returns — it only arrives in the signer's notification email or
# WhatsApp message. Paste one here to run the signer-side live assertions.
ASSINAFY_TEST_SIGNER_ACCESS_CODE=
