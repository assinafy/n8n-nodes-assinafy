# Sandbox-only live integration tests. Never commit real values.
ASSINAFY_LIVE=0
ASSINAFY_LIVE_DESTRUCTIVE=0
# Extra opt-in for isolated workspace/logo/webhook create-update-delete checks.
ASSINAFY_LIVE_WORKSPACE_MUTATIONS=0
ASSINAFY_API_KEY=<sandbox-api-key>
ASSINAFY_ACCOUNT_ID=<sandbox-account-id>
ASSINAFY_BASE_URL=https://sandbox.assinafy.com.br/v1
# Required only for the explicitly destructive signer/notification scenario.
ASSINAFY_TEST_EMAIL_PRIMARY=<sandbox-test-email>
ASSINAFY_TEST_EMAIL_SECONDARY=<second-sandbox-test-email>
