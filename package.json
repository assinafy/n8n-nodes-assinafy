{
	"name": "@assinafy/n8n-nodes-assinafy",
	"version": "1.5.0",
	"description": "n8n community nodes for the Assinafy electronic-signature API (documents, signers, assignments, templates, tags, webhooks).",
	"license": "MIT",
	"packageManager": "npm@11.16.0",
	"homepage": "https://github.com/assinafy/n8n-nodes-assinafy",
	"keywords": [
		"n8n-community-node-package",
		"assinafy",
		"e-signature",
		"electronic-signature",
		"pdf",
		"contracts"
	],
	"author": {
		"name": "Assinafy",
		"email": "suporte@assinafy.com.br"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/assinafy/n8n-nodes-assinafy.git"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "n8n-node dev",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "jest",
		"test:ci": "jest --coverage --runInBand",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"audit:prod": "npm audit --omit=dev --audit-level=high"
	},
	"engines": {
		"node": ">=22.22"
	},
	"files": [
		"dist",
		"!dist/coverage",
		"docs/OPERATIONS.md",
		"CHANGELOG.md",
		"CONTRIBUTING.md",
		"LICENSE.md",
		"README.md",
		"SECURITY.md"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AssinafyApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Assinafy/Assinafy.node.js",
			"dist/nodes/AssinafyTrigger/AssinafyTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.43.1",
		"@types/jest": "^30.0.0",
		"eslint": "10.8.0",
		"jest": "^30.4.2",
		"n8n-workflow": "2.34.1",
		"prettier": "3.9.6",
		"ts-jest": "^29.4.12",
		"typescript": "7.0.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
